{
  "name": "tilli-monorepo-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "check:architecture": "depcruise contexts packages apps tests --config .dependency-cruiser.cjs",
    "test": "pnpm -r test",
    "verify": "pnpm lint && pnpm typecheck && pnpm check:architecture && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@swc/core": "^1.16.22",
    "dependency-cruiser": "^18.7.2"
  }
}
